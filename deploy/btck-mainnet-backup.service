[Unit]
Description=Low-impact backup of BTC-K MAINNET state
After=btckd.service
Requires=btckd.service

[Service]
Type=oneshot
TimeoutStartSec=50min
TimeoutStopSec=15s
User=btck
Group=btck
WorkingDirectory=/opt/btck/current
ExecStart=/usr/bin/python3 /opt/btck/current/deploy/backup_guardian_state.py
UMask=0077
Nice=19
IOSchedulingClass=idle
CPUQuota=10%
MemoryHigh=384M
MemoryMax=640M
TasksMax=16
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
# SQLite WAL readers must be able to coordinate through the existing -shm
# files. The backup code still opens every source database in mode=ro.
ReadWritePaths=/var/lib/btck-backups /var/lib/btck/mainnet /var/lib/btck-pool
