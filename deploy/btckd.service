[Unit]
Description=BTC-K checkpoint-bound MAINNET seed node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=btck
Group=btck
WorkingDirectory=/opt/btck/current
EnvironmentFile=/etc/btck/btckd.env
ExecStart=/opt/btck/current/deploy/run_seed_node.sh
Restart=on-failure
RestartSec=5s
LimitNOFILE=65535
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
ReadWritePaths=/var/lib/btck

[Install]
WantedBy=multi-user.target
