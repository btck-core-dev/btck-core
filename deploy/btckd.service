[Unit]
Description=BTC-K Sovereign BlockDAG Seed Node Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=btck
WorkingDirectory=/opt/btck-core
Environment=BTCK_NETWORK=devnet
EnvironmentFile=-/etc/btck/btckd.env
ExecStart=/usr/bin/python3 /opt/btck-core/src/node/daemon.py --host 127.0.0.1 --p2p-host 0.0.0.0 --port 16110 --p2p-port 16111 --data-root /var/lib/btck
Restart=on-failure
RestartSec=5s
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/btck
CapabilityBoundingSet=
LockPersonality=true

[Install]
WantedBy=multi-user.target
