limit_req_zone $binary_remote_addr zone=btck_wallet_sync_per_ip:10m rate=5r/s;
limit_conn_zone $binary_remote_addr zone=btck_wallet_sync_connections:10m;

server {
    listen 80;
    listen [::]:80;
    server_name __BTCK_WALLET_HOST__;
    allow 51.195.136.143;
    deny all;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 308 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __BTCK_WALLET_HOST__;
    allow 51.195.136.143;
    deny all;

    ssl_certificate /etc/letsencrypt/live/__BTCK_WALLET_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__BTCK_WALLET_HOST__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    location = / {
        default_type text/html;
        return 200 '<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>BTC-K Wallet Service</title></head><body style="margin:3rem auto;max-width:44rem;padding:0 1.25rem;background:#0d1117;color:#e6edf3;font:16px/1.6 system-ui"><h1>BTC-K Wallet Service</h1><p>The private mainnet synchronization service is online.</p><p>Use the signed desktop wallet to view balances and sign transactions. Private keys and recovery words must never be entered into a website.</p></body></html>';
    }

    location = /edge-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /api/wallet/sync {
        limit_except GET HEAD { deny all; }
        limit_req zone=btck_wallet_sync_per_ip burst=15 nodelay;
        limit_req_status 429;
        limit_conn btck_wallet_sync_connections 4;

        proxy_pass http://127.0.0.1:18088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
        proxy_send_timeout 10s;
        proxy_buffering on;
    }

    location / { return 404; }
}
