[Unit]
Description=BTC-K approaching-checkpoint evidence sampler
After=btck-mainnet-node.service btck-mainnet-stratum.service
Wants=btck-mainnet-node.service btck-mainnet-stratum.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
UMask=0077
ExecStart=/usr/bin/python3 /home/ubuntu/btck-mainnet-guardian/scripts/mine_checkpoint_sampler.py --once --url http://127.0.0.1:18088/api/stats --output-dir /home/ubuntu/btck-mainnet-guardian/evidence/sampler
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/btck-mainnet-guardian/evidence/sampler

