[Unit]
Description=BTC-K MAINNET Guardian Node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/btck-mainnet-guardian
EnvironmentFile=/home/ubuntu/btck-mainnet-guardian/evidence/guardian.env
ExecStart=/usr/bin/python3 /home/ubuntu/btck-mainnet-guardian/src/node/daemon.py --network mainnet --network-manifest /home/ubuntu/btck-mainnet-guardian/params/networks/mainnet.guardian.json --data-root /home/ubuntu/btck-mainnet-guardian/data-root --host 127.0.0.1 --port 17110 --p2p-host 127.0.0.1 --p2p-port 17111
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/btck-mainnet-guardian/data-root /home/ubuntu/btck-mainnet-guardian/logs
UMask=0077

[Install]
WantedBy=multi-user.target
