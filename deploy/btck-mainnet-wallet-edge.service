[Unit]
StartLimitIntervalSec=0
Description=BTC-K MAINNET Read-Only Wallet Sync Edge
After=network-online.target btckd.service btck-public-stratum-solo.service
Requires=btckd.service
Wants=btck-public-stratum-solo.service

[Service]
Type=simple
User=btck
Group=btck
WorkingDirectory=/opt/btck/current
EnvironmentFile=/etc/btck/btckd.env
EnvironmentFile=/etc/btck/web-edge.env
Environment=PYTHONPATH=/opt/btck/current/src
Environment=BTCK_EXPLORER_HOST=127.0.0.1
Environment=BTCK_NODE_INFO_URL=http://127.0.0.1:16110/dashboard
Environment=BTCK_NODE_RPC_URL=http://127.0.0.1:16110/rpc
Environment=BTCK_STRATUM_STATUS_URL=http://127.0.0.1:3337/status
Environment=BTCK_PPLNS_STATUS_URL=http://127.0.0.1:3338/status
ExecStart=/usr/bin/python3 /opt/btck/current/src/web_explorer_server.py 18088
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
