<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bitcoink.guardian-backup-pull</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/opt/btck-core/scripts/pull_mainnet_backup.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/opt/btck-core</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>ThrottleInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>/opt/btck-core/logs/guardian-backup-pull.log</string>
  <key>StandardErrorPath</key>
  <string>/opt/btck-core/logs/guardian-backup-pull.err.log</string>
</dict>
</plist>
